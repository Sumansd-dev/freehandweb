ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Browser Automation
PLAYWRIGHT_HEADLESS=true
MOCK_PORTAL_URL=http://127.0.0.1:8000/portal/

# MCP Server
